{
  "name": "sidekick",
  "version": "0.3.0",
  "description": "A floating desktop assistant powered by Claude",
  "main": "src/main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "icon": "node scripts/make-icon.js",
    "server": "node src/server.js",
    "dist": "electron-builder --win nsis"
  },
  "author": "sang-ute",
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "private": true,
  "build": {
    "appId": "com.sidekick.assistant",
    "productName": "Sidekick",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "renderer/**",
      "assets/**",
      "package.json"
    ],
    "asar": false,
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sidekick"
    }
  }
}
